      "id": 2,
      "gridPos": {
        "y": 0,
        "w": 12,
        "h": 8,
        "x": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "title": "User requests / second",
      "targets": [
        {
          "legendFormat": "{{pod}}{{area}}",
          "expr": "sum(rate(http_server_requests_seconds_count{namespace=\"crewmeister\",service=\"crewmeister-app\",uri=\"/user\"}[5m]))",
          "refId": "A"
        }
      ],
      "type": "timeseries",
      "options": {
        "legend": {
          "placement": "bottom",
          "displayMode": "list"
        }
      }
    },
    {
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "id": 3,
      "gridPos": {
        "y": 8,
        "w": 12,
        "h": 8,
        "x": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "title": "Mean request latency",
      "targets": [
        {
          "legendFormat": "{{pod}}{{area}}",
          "expr": "sum(rate(http_server_requests_seconds_sum{namespace=\"crewmeister\",service=\"crewmeister-app\",uri=\"/user\"}[5m])) / clamp_min(sum(rate(http_server_requests_seconds_count{namespace=\"crewmeister\",service=\"crewmeister-app\",uri=\"/user\"}[5m])), 0.000001)",
          "refId": "A"
        }
      ],
      "type": "timeseries",
      "options": {
        "legend": {
          "placement": "bottom",
          "displayMode": "list"
        }
      }
    },
    {
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
