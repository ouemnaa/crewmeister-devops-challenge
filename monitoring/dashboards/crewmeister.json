        "y": 0,
        "w": 12,
        "h": 8,
        "x": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "title": "Application target",
      "targets": [
        {
          "legendFormat": "{{pod}}{{area}}",
          "expr": "up{namespace=\"crewmeister\",service=\"crewmeister-app\"}",
          "refId": "A"
        }
      ],
      "type": "stat",
      "options": {
        "legend": {
          "placement": "bottom",
          "displayMode": "list"
        }
      }
    },
    {
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
