      "gridPos": {
        "y": 8,
        "w": 12,
        "h": 8,
        "x": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "title": "HTTP 5xx / second",
      "targets": [
        {
          "legendFormat": "{{pod}}{{area}}",
          "expr": "sum(rate(http_server_requests_seconds_count{namespace=\"crewmeister\",service=\"crewmeister-app\",status=~\"5..\"}[5m]))",
          "refId": "A"
        }
      ],
      "type": "timeseries",
      "options": {
        "legend": {
          "placement": "bottom",
          "displayMode": "list"
        }
      }
    },
